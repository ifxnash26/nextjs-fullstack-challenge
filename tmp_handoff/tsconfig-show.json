{
    "compilerOptions": {
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "baseUrl": "./",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": [
                "./*"
            ],
            "@/server/*": [
                "./src/server/*"
            ]
        },
        "allowSyntheticDefaultImports": true,
        "resolvePackageJsonExports": true,
        "resolvePackageJsonImports": true,
        "preserveConstEnums": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "strictPropertyInitialization": true,
        "strictBuiltinIteratorReturn": true,
        "alwaysStrict": true,
        "useUnknownInCatchVariables": true
    },
    "files": [
        "./next-env.d.ts",
        "./next-auth.d.ts",
        "./prisma.config.ts",
        "./tailwind.config.ts",
        "./vitest.config.ts",
        "./app/api/ai/actions/execute/route.ts",
        "./app/api/ai/actions/plan/route.ts",
        "./app/api/ai/assignees/route.ts",
        "./app/api/ai/assistant/route.ts",
        "./app/api/ai/explain-audit/route.ts",
        "./app/api/ai/filter/route.ts",
        "./app/api/ai/summarize-asset/route.ts",
        "./app/api/assets/route.ts",
        "./app/api/assets/[assetId]/route.ts",
        "./app/api/assets/[assetId]/handoff/route.ts",
        "./app/api/assets/[assetId]/summary/route.ts",
        "./app/api/assets/export/route.ts",
        "./app/api/assets/import/route.ts",
        "./app/api/audit/data-quality/route.ts",
        "./app/api/auth/[...nextauth]/route.ts",
        "./lib/ai-client.ts",
        "./lib/ai.ts",
        "./lib/assets.ts",
        "./lib/auth.ts",
        "./lib/constants.ts",
        "./lib/prisma.ts",
        "./lib/rbac.ts",
        "./lib/utils.ts",
        "./lib/validators.ts",
        "./lib/workspaces.ts",
        "./scripts/fill-missing-asset-details.ts",
        "./scripts/import-csv.ts",
        "./src/server/ai/buildFilterSpec.ts",
        "./src/server/ai/filterSpec.ts",
        "./src/server/ai/summarizeAsset.ts",
        "./src/server/ai/actions/planFromMessage.ts",
        "./src/server/ai/actions/previewPlan.ts",
        "./src/server/ai/actions/schemas.ts",
        "./src/server/audit/dataQuality.ts",
        "./tests/ai-filter.test.ts",
        "./tests/ai-manager.test.ts",
        "./tests/ai.test.ts",
        "./tests/assets.test.ts",
        "./tests/dataQuality.test.ts",
        "./tests/summarize-asset.test.ts",
        "./tests/validators.test.ts",
        "./app/layout.tsx",
        "./app/page.tsx",
        "./app/admin/users/page.tsx",
        "./app/login/page.tsx",
        "./app/w/[workspaceId]/layout.tsx",
        "./app/w/[workspaceId]/assets/page.tsx",
        "./app/w/[workspaceId]/assets/[assetId]/page.tsx",
        "./app/w/[workspaceId]/assets/[assetId]/handoff/page.tsx",
        "./app/w/[workspaceId]/assets/[assetId]/handoff/print-controls.tsx",
        "./app/w/[workspaceId]/assets/board/page.tsx",
        "./app/w/[workspaceId]/assets/new/page.tsx",
        "./app/w/[workspaceId]/assignees/page.tsx",
        "./components/ai-inventory-manager.tsx",
        "./components/ai-workspace.tsx",
        "./components/ask-ai-filter.tsx",
        "./components/asset-editor.tsx",
        "./components/asset-list-toggle.tsx",
        "./components/asset-status-badge.tsx",
        "./components/asset-summary-button.tsx",
        "./components/assignee-ai.tsx",
        "./components/create-asset-form.tsx",
        "./components/data-quality-audit.tsx",
        "./components/import-export-bar.tsx",
        "./components/login-form.tsx",
        "./components/providers.tsx",
        "./components/sign-out-button.tsx",
        "./components/theme-toggle.tsx",
        "./components/workspace-header.tsx",
        "./components/ui/alert.tsx",
        "./components/ui/badge.tsx",
        "./components/ui/button.tsx",
        "./components/ui/card.tsx",
        "./components/ui/input.tsx",
        "./components/ui/select.tsx",
        "./components/ui/table.tsx",
        "./components/ui/textarea.tsx",
        "./.next/types/app/layout.ts"
    ],
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
